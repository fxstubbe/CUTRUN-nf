/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal end-to-end test on the synthetic dataset in assets/test_data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Four libraries (two H3K27me3 targets, each with a no-antibody control) on a toy
    "worm" genome (I, II, X, MtDNA; 306 kb) with a toy E. coli spike-in. Bowtie2 indices
    are built on the fly. Regenerate the data with assets/test_data/make_test_data.py.

    Use as follows:
        nextflow run main.nf -profile test,<docker|apptainer|conda> [--outdir <OUTDIR>]
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [cpus: 4, memory: 8.GB, time: 1.h]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic CUT&RUN dataset exercising every pipeline step'

    metadata     = "${projectDir}/assets/test_data/samplesheet_test.csv"
    outdir       = 'results_test'

    genome       = 'test_worm'     // label only: the FASTA below is used, not iGenomes
    spike_genome = 'test_ecoli'
    fasta        = "${projectDir}/assets/test_data/worm.fa"
    spike_fasta  = "${projectDir}/assets/test_data/ecoli.fa"
    mito_name    = 'MtDNA'
}
