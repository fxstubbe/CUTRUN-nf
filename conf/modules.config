/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ext.args   = additional arguments appended to the command
    ext.args2  = second set of arguments (multi-tool modules)
    ext.prefix = file name prefix of the outputs
----------------------------------------------------------------------------------------
*/

process {

    // ####################################################################################
    // QC
    // ####################################################################################

    withName: 'TRIMGALORE' {
        publishDir = [
            path: { "${params.outdir}/01_QC/trimgalore" },
            mode: params.publish_dir_mode,
            pattern: '*report.txt'          // TrimGalore writes *_trimming_report.txt
        ]
    }

    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/01_QC/fastqc" },
            mode: params.publish_dir_mode,
            pattern: '*.html'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/01_QC/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FRAGMENT_LEN' {
        ext.args   = '-F 0x04'
        // |TLEN| per alignment -> histogram; /2 because both mates carry the same TLEN
        ext.args2  = "awk -F'\\t' 'function abs(x){return ((x < 0.0) ? -x : x)} {print abs(\$9)}' | sort -T '.' | uniq -c | awk -v OFS=\"\\t\" '{print \$2, \$1/2}' | sort -k1,1n"
        ext.suffix = '.frags.len'
        publishDir = [
            path: { "${params.outdir}/01_QC/Fragments_length_fromBAM" },
            mode: params.publish_dir_mode,
            pattern: '*.txt'
        ]
    }

    // ####################################################################################
    // Reference preparation
    // ####################################################################################

    withName: 'CUSTOM_GETCHROMSIZES' {
        publishDir = [ enabled: false ]
    }

    withName: 'BOWTIE2_BUILD_TARGET|BOWTIE2_BUILD_SPIKEIN' {
        publishDir = [ enabled: false ]
    }

    // ####################################################################################
    // Alignment
    // ####################################################################################

    withName: 'BOWTIE2_TARGET_ALIGN' {
        ext.args   = { (params.end_to_end.toString().toBoolean() ? '--end-to-end' : '--local') + ' --very-sensitive --no-mixed --no-discordant --phred33 --minins 10 --maxins 700 --dovetail' }
        publishDir = [
            [
                path: { "${params.outdir}/02_alignment/${params.genome}/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/02_alignment/${params.genome}/BAM" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: params.save_bam_unsorted.toString().toBoolean()
            ],
            [
                path: { "${params.outdir}/02_alignment/${params.genome}/unmapped" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                enabled: params.save_unmapped_reads.toString().toBoolean()
            ]
        ]
    }

    withName: 'BOWTIE2_SPIKEIN_ALIGN' {
        ext.args   = { (params.end_to_end.toString().toBoolean() ? '--end-to-end' : '--local') + ' --very-sensitive --no-mixed --no-discordant --phred33 --minins 10 --maxins 700 --dovetail' }
        publishDir = [
            [
                path: { "${params.outdir}/02_alignment/${params.spike_genome}/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/02_alignment/${params.spike_genome}/BAM" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: params.save_bam_spikein_aligned.toString().toBoolean()
            ]
        ]
    }

    // ---- Sort / index / stats of the raw alignment (BAM_SORT_STATS_SAMTOOLS)

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.${params.genome}.sorted" }
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/BAM" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_bam_sorted.toString().toBoolean()
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/BAM" },
            mode: params.publish_dir_mode,
            pattern: '*.bai',
            enabled: params.save_bam_sorted.toString().toBoolean()
        ]
    }

    withName: 'SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|SAMTOOLS_IDXSTATS' {
        ext.prefix = { "${meta.id}.${params.genome}.sorted" }
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/log" },
            mode: params.publish_dir_mode,
            pattern: '*.{stats,flagstat,idxstats}',
            enabled: params.save_bam_sorted_stats.toString().toBoolean()
        ]
    }

    // ---- Read filtering: MAPQ, proper pairs, primary only, mitochondria out

    withName: 'SAMTOOLS_VIEW' {
        // -q MAPQ   -f 0x002 proper pair   -F 0x904 drop unmapped / secondary / supplementary
        // The mito filter is an -e expression and lives in ext.args (before the input
        // file), so it is parsed as an option on every platform.
        ext.args   = {
            def mito = params.mito_name ?: (params.genomes?.get(params.genome)?.mito_name)
            [
                "-b -q ${params.minimum_alignment_q_score} -f 0x002 -F 0x904",
                (params.remove_mitochondrial_reads.toString().toBoolean() && mito) ? "-e 'rname != \"${mito}\"'" : ''
            ].join(' ').trim()
        }
        ext.args2  = ''
        ext.prefix = { "${meta.id}.${params.genome}.filtered" }
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/BAM" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_bam_filtered_unsorted.toString().toBoolean()
        ]
    }

    withName: '.*:SAMTOOLS_VIEW_SORT:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.${params.genome}.filter.sort" }
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/BAM" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: '.*:SAMTOOLS_VIEW_SORT:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/BAM" },
            mode: params.publish_dir_mode,
            pattern: '*.bai'
        ]
    }

    withName: '.*:SAMTOOLS_VIEW_SORT:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}.${params.genome}.filter.sort" }
        publishDir = [
            path: { "${params.outdir}/02_alignment/${params.genome}/log" },
            mode: params.publish_dir_mode,
            pattern: '*.{stats,flagstat,idxstats}',
            enabled: params.save_bam_sorted_stats.toString().toBoolean()
        ]
    }

    // ####################################################################################
    // Normalised tracks
    // ####################################################################################

    withName: 'BEDTOOLS_GENOMECOV' {
        // meta.norm is 'spikein' or 'raw' (normalisation_to_spikein = false)
        ext.prefix = { "${meta.id}.${meta.norm}" }
        ext.args   = { params.extend_fragments.toString().toBoolean() ? '-bg -pc' : '-bg' }
        publishDir = [
            path: { "${params.outdir}/03_Norm/bedgraph" },
            mode: params.publish_dir_mode,
            pattern: '*.bedgraph'
        ]
    }

    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        ext.args   = {
            [
                '--outFileFormat bigwig',
                '--skipNAs',
                "--binSize ${params.normalisation_binsize}",
                "--normalizeUsing ${params.normalisation_mode}",
                params.extend_fragments.toString().toBoolean() ? '--extendReads' : ''
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.${params.normalisation_mode}" }
        publishDir = [
            path: { "${params.outdir}/03_Norm/bigwig" },
            mode: params.publish_dir_mode,
            pattern: '*.bigWig'
        ]
    }

    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        // spike-in scaled bedGraph -> bigWig, same values (see subworkflows/local/Bam_Norm.nf)
        ext.prefix = { "${meta.id}.${meta.norm}" }
        publishDir = [
            path: { "${params.outdir}/03_Norm/bigwig" },
            mode: params.publish_dir_mode,
            pattern: '*.bigWig'
        ]
    }

    // ####################################################################################
    // Genomic windows (one pass per size in params.window_sizes)
    // ####################################################################################

    withName: 'MAKE_WINDOWS' {
        publishDir = [
            path: { "${params.outdir}/04_windows/${wmeta.bin}" },
            mode: params.publish_dir_mode,
            pattern: '*.windows.bed'
        ]
    }

    withName: 'BEDTOOLS_COVERAGE' {
        ext.prefix = { "${meta.id}_${meta.bin}_windows" }
        publishDir = [
            path: { "${params.outdir}/04_windows/${meta.bin}/per_library" },
            mode: params.publish_dir_mode,
            pattern: '*.bed',
            enabled: params.save_window_beds.toString().toBoolean()
        ]
    }

    withName: 'MERGE_WINDOW_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/04_windows/${bin}" },
            mode: params.publish_dir_mode,
            pattern: '*.{csv,csv.gz}'
        ]
    }

    // ####################################################################################
    // Peak calling
    // ####################################################################################

    withName: 'SEACR_CALLPEAK' {
        ext.args   = { "${params.seacr_norm} ${params.seacr_stringent}" }
        ext.prefix = { "${meta.id}.seacr.peaks" }
        publishDir = [
            path: { "${params.outdir}/05_PeakCalling/SEACR" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }
}
