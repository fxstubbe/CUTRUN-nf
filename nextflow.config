/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CUTRUN-nf : CUT&RUN analysis with E. coli carry-over spike-in normalisation
    https://github.com/fxstubbe/CUTRUN-nf
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defaults live here. Run-specific values (samplesheet, outdir, genome base) go in a
    params file:  nextflow run main.nf -profile <profile> -params-file params.yml
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'fxstubbe/CUTRUN-nf'
    homePage        = 'https://github.com/fxstubbe/CUTRUN-nf'
    description     = 'CUT&RUN analysis with E. coli carry-over spike-in normalisation and multi-resolution genomic windows'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.5'
    version         = '1.1.0'
}

params {

    // ---- Input / output (mandatory, normally set in params.yml)
    metadata                   = null   // CSV: id,group,replicate,control,fastq_path_1,fastq_path_2
    outdir                     = null

    // ---- Reference genomes
    igenomes_base              = 's3://ngi-igenomes/igenomes'
    genome                     = 'WBcel235'
    spike_genome               = 'EB1'
    // Optional explicit references; override the iGenomes entries when set.
    // If a FASTA is given without an index, the Bowtie2 index is built by the pipeline.
    fasta                      = null
    bowtie2_index              = null
    spike_fasta                = null
    spike_bowtie2_index        = null

    // ---- MultiQC
    multiqc_title              = 'Report_Summary_multiqc'

    publish_dir_mode           = 'copy'

    // ---- Alignment
    end_to_end                 = true

    // ---- What to publish
    save_bam_unsorted          = true
    save_unmapped_reads        = true
    save_bam_spikein_aligned   = true
    save_bam_sorted            = true
    save_bam_sorted_stats      = false
    save_bam_filtered_unsorted = false  // the sorted copy (*.filter.sort.bam) is always published

    // ---- Read filtering
    minimum_alignment_q_score  = 30
    remove_mitochondrial_reads = true
    mito_name                  = null   // default: taken from the genome entry (WBcel235: MtDNA)

    // ---- Normalisation
    normalisation_to_spikein   = true   // spike-in scaled bedGraph + bigWig
    normalisation_mode         = 'CPM'  // bamCoverage --normalizeUsing for the depth-normalised bigWig
    normalisation_binsize      = 50
    normalisation_c            = 10000  // scale factor = normalisation_c / concordant spike-in pairs
    extend_fragments           = true

    // ---- Genomic windows (bins x libraries count matrices)
    split                      = true
    window_sizes               = '1000,5000,10000,20000,50000,100000'  // bp, comma-separated
    save_window_beds           = true   // per-library coverage BEDs next to each merged matrix

    // ---- Peak calling (SEACR on the spike-in scaled bedGraphs)
    run_peak_calling           = true
    use_control                = true   // false: every target is called against seacr_peak_threshold
    seacr_norm                 = 'non'  // 'non' because the bedGraphs are already spike-in scaled
    seacr_stringent            = 'stringent'
    seacr_peak_threshold       = 0.05

    // ---- QC
    fragment_len_reporting     = true

    // ---- Kept for backward compatibility, not read by the workflow
    igg_scale_factor           = 0.5
}

includeConfig 'conf/base.config'
includeConfig 'conf/igenomes.config'
includeConfig 'conf/modules.config'

// Profiles come last so that their settings win over the defaults above.
profiles {
    my_laptop {
        process.executor       = 'local'
        conda.enabled          = true
        process.resourceLimits = [cpus: 8, memory: 12.GB, time: 24.h]
    }
    my_tower {
        process.executor       = 'local'
        docker.enabled         = true
        process.resourceLimits = [cpus: 28, memory: 20.GB, time: 24.h]
        params.igenomes_base   = '/mnt/d/CR_igenomes'
    }
    unige_baobab {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        process.executor       = 'slurm'
        process.queue          = 'shared-cpu'
        process.scratch        = true
        process.errorStrategy  = 'retry'
        process.maxRetries     = 2
        // Per-task requests come from the process labels in conf/base.config,
        // capped here to what one shared-cpu job may ask for.
        process.resourceLimits = [cpus: 12, memory: 72.GB, time: 12.h]
    }
    conda {
        conda.enabled          = true
    }
    docker {
        docker.enabled         = true
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}
